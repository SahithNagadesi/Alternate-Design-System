# ===========================================
# Frontier XD - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Database - PostgreSQL (Neon recommended for Vercel)
DATABASE_URL="postgresql://user:password@host/frontierxd?sslmode=require"

# NextAuth.js
NEXTAUTH_SECRET="generate-a-random-32-char-string"
NEXTAUTH_URL="http://localhost:3000"

# Anthropic Claude API (org-level key)
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# Custom base URL for enterprise proxy / model vending machine
# Leave empty to use default Anthropic API (api.anthropic.com)
ANTHROPIC_BASE_URL=""

# Model override (leave empty for default: claude-sonnet-4-20250514)
ANTHROPIC_MODEL=""

# Vercel Blob Storage (for file uploads)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your-token-here"

# Encryption key for Pega credentials (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
