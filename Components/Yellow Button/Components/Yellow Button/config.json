{
  "name": "Pega_Custom_YellowButton",
  "label": "Yellow Button - Proceed",
  "description": "A yellow proceed/action button for Pega Constellation. Fires Pega actions (finishAssignment, navigateToStep, custom) on click. Fully configurable via App Studio.",
  "organization": "Pega",
  "version": "1.0.0",
  "library": "Custom",
  "type": "Component",
  "subtype": "Field",
  "icon": "auto",
  "properties": [
    {
      "name": "label",
      "label": "Button Label",
      "format": "TEXT",
      "defaultValue": "Proceed",
      "required": true
    },
    {
      "name": "disabled",
      "label": "Disabled",
      "format": "BOOLEAN",
      "defaultValue": false
    },
    {
      "name": "size",
      "label": "Size",
      "format": "TEXT",
      "defaultValue": "medium",
      "allowedValues": ["small", "medium", "large"]
    },
    {
      "name": "variant",
      "label": "Variant",
      "format": "TEXT",
      "defaultValue": "primary",
      "allowedValues": ["primary", "secondary"]
    },
    {
      "name": "showIcon",
      "label": "Show Arrow Icon",
      "format": "BOOLEAN",
      "defaultValue": true
    },
    {
      "name": "visibility",
      "label": "Visibility",
      "format": "BOOLEAN",
      "defaultValue": true
    },
    {
      "name": "actionType",
      "label": "Action Type",
      "format": "TEXT",
      "defaultValue": "finishAssignment",
      "allowedValues": [
        "finishAssignment",
        "cancelAssignment",
        "navigateToStep",
        "openLocalAction",
        "custom"
      ]
    },
    {
      "name": "actionParams",
      "label": "Action Parameters (JSON)",
      "format": "TEXT",
      "defaultValue": "{}"
    },
    {
      "name": "testId",
      "label": "Test ID",
      "format": "TEXT",
      "defaultValue": "yellow-proceed-button"
    }
  ],
  "events": [
    {
      "name": "onClick",
      "label": "On Click",
      "description": "Fired when the button is clicked"
    }
  ],
  "presets": [
    {
      "name": "ProceedDefault",
      "label": "Proceed (Default)",
      "properties": {
        "label": "Proceed",
        "size": "medium",
        "variant": "primary",
        "showIcon": true,
        "actionType": "finishAssignment"
      }
    },
    {
      "name": "ContinueLarge",
      "label": "Continue (Large)",
      "properties": {
        "label": "Continue",
        "size": "large",
        "variant": "primary",
        "showIcon": true,
        "actionType": "finishAssignment"
      }
    },
    {
      "name": "NextStepSecondary",
      "label": "Next Step (Secondary)",
      "properties": {
        "label": "Next Step",
        "size": "medium",
        "variant": "secondary",
        "showIcon": true,
        "actionType": "navigateToStep"
      }
    },
    {
      "name": "SubmitNoIcon",
      "label": "Submit (No Icon)",
      "properties": {
        "label": "Submit",
        "size": "medium",
        "variant": "primary",
        "showIcon": false,
        "actionType": "finishAssignment"
      }
    }
  ]
}
