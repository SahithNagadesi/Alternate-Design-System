generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum ProjectType {
  COMPONENT
  APPLICATION
}

enum MemberRole {
  OWNER
  MEMBER
}

enum MessageRole {
  USER
  ASSISTANT
}

enum PublishStatus {
  IN_PROGRESS
  SUCCESS
  FAILED
}

enum FolderVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects       ProjectMember[]
  publishHistory PublishHistory[]
  createdFolders DocumentFolder[]
  folderAccess   FolderAccess[]
}

model Project {
  id              String      @id @default(cuid())
  name            String
  type            ProjectType
  pegaServerUrl   String?
  pegaCredentials String?
  folderPath      String
  githubRepo      String?
  githubFolder    String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  members          ProjectMember[]
  chatMessages     ChatMessage[]
  contextDocuments ContextDocument[]
  publishHistory   PublishHistory[]
  folderLinks      ProjectFolderLink[]
}

model ProjectMember {
  userId    String
  projectId String
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model ChatMessage {
  id              String      @id @default(cuid())
  projectId       String
  role            MessageRole
  content         String
  fileAttachments Json?
  createdAt       DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ContextDocument {
  id        String   @id @default(cuid())
  projectId String
  name      String
  filePath  String
  blobUrl   String
  mimeType  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PublishHistory {
  id             String        @id @default(cuid())
  projectId      String
  userId         String
  pegaServerUrl  String
  status         PublishStatus @default(IN_PROGRESS)
  componentFiles Json
  errorMessage   String?
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model DocumentFolder {
  id          String           @id @default(cuid())
  name        String
  description String?
  visibility  FolderVisibility @default(PUBLIC)
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy    User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  documents    GlobalDocument[]
  accessGrants FolderAccess[]
  projectLinks ProjectFolderLink[]
}

model GlobalDocument {
  id        String   @id @default(cuid())
  folderId  String
  name      String
  filePath  String
  blobUrl   String
  mimeType  String
  fileSize  Int      @default(0)
  createdAt DateTime @default(now())

  folder DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

model FolderAccess {
  id        String   @id @default(cuid())
  folderId  String
  userId    String
  createdAt DateTime @default(now())

  folder DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
}

model ProjectFolderLink {
  id        String   @id @default(cuid())
  projectId String
  folderId  String
  createdAt DateTime @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder  DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([projectId, folderId])
}
